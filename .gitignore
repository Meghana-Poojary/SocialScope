# ============================================================
# SocialScope .gitignore
# Keeps the repo to source code, config and docs. Everything
# here is generated, downloaded, local-only, or secret.
# ============================================================

# ---------- Secrets & local environment ----------
.env
.env.*
!.env.example
kaggle.json
**/.kaggle/
*.pem
*.key

# ---------- Data (generated or downloaded; can be large) ----------
# Synthetic sample:  python ingestion/generate_sample.py
# Kaggle dataset:    ./scripts/docker_pipeline.ps1 -Source kaggle
data/raw/*
!data/raw/.gitkeep
data/kaggle/*
!data/kaggle/mapping.example.json
!data/kaggle/.gitkeep
data/output/
data/curated/
*.parquet
*.jsonl
*.zip
*.part

# ---------- Local docs / screenshots (not part of the code) ----------
docs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---------- Spark / Hadoop local runs ----------
spark-warehouse/
metastore_db/
derby.log
checkpoints/
*.crc
_SUCCESS
_spark_metadata/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Logs & temp ----------
*.log
*.tmp
*.bak
*.swp
tmp/

# ---------- Editors & tools ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
.claude/settings.local.json

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
